FROM alpine:latest

ARG PB_VERSION=0.28.4

RUN apk add --no-cache \
    unzip \
    ca-certificates

# download and unzip PocketBase
ADD https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip /tmp/pb.zip
RUN unzip /tmp/pb.zip -d /pb/

# Create directories for migrations
RUN mkdir -p /pb/migrations

# Copy migrations if they exist
COPY ./migrations /pb/migrations

# Copy main.go and go module files for custom PocketBase build
COPY ./main.go /pb/
COPY ./go.mod /pb/
COPY ./go.sum /pb/

# Build custom PocketBase with migrations
WORKDIR /pb
RUN apk add --no-cache go
RUN go build -o pocketbase-custom main.go

EXPOSE 8080

CMD ["/pb/pocketbase-custom", "serve", "--http=0.0.0.0:8080"]